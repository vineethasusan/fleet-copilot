# Choose: auto | anthropic | openai | offline  (auto picks whichever key is set, else offline)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# chroma | tfidf | auto
RETRIEVER=auto
FLEET_DB_PATH=data/fleet.db
MAX_ROWS=500
QUERY_TIMEOUT_S=10
MAX_REPAIR_ATTEMPTS=2
